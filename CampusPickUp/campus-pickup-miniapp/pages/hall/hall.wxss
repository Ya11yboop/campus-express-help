.search-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1f2d3d;
}

.search-icon {
  font-size: 28rpx;
}

.search-row {
  margin-bottom: 16rpx;
}

.search-field {
  display: flex;
  align-items: center;
}

.field-label {
  width: 90rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  height: 64rpx;
  box-sizing: border-box;
}

.sep {
  margin: 0 16rpx;
  color: #999;
}

.search-picker {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  height: 64rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}

.search-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.search-btns button {
  flex: 1;
  margin: 0;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  background: #ecf5ff;
  color: #409eff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.no {
  color: #999;
  font-size: 24rpx;
}

.info {
  display: block;
  color: #666;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.info-icon {
  margin-right: 8rpx;
}

.bottom {
  margin-top: 16rpx;
}

.fee {
  color: #f56c6c;
  font-weight: bold;
  font-size: 30rpx;
}

.status {
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: #ecf5ff;
  color: #409eff;
  font-weight: 600;
  font-size: 26rpx;
}

.empty {
  color: #ccc;
  text-align: center;
  padding: 60rpx 0;
}
