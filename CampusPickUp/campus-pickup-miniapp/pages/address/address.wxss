.container {
  padding: 30rpx;
  padding-bottom: 160rpx;
}

.addr-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}

.addr-card.selected {
  border-color: #409eff;
}

.addr-top {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 32rpx;
  font-weight: bold;
}

.addr-phone {
  margin-left: 20rpx;
  color: #666;
  font-size: 28rpx;
}

.addr-default {
  margin-left: auto;
  background: #409eff;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.addr-selected {
  margin-left: 12rpx;
  color: #409eff;
  font-size: 24rpx;
  font-weight: bold;
}

.addr-detail {
  display: block;
  margin-top: 16rpx;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action {
  color: #409eff;
  font-size: 26rpx;
}

.action.danger {
  color: #f56c6c;
}

.empty {
  color: #ccc;
  text-align: center;
  padding: 40rpx 0;
}

.add-btn {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  border-radius: 44rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.form-panel {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  z-index: 101;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 26rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  color: #666;
  font-size: 26rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.form-btns button {
  flex: 1;
  margin: 0;
}
