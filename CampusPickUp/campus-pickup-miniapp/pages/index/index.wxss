.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 6rpx 26rpx;
}

.top-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.top-slogan {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a6ad;
}

.top-bell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bell-icon {
  font-size: 36rpx;
}

.bell-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #f56c6c;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.banner-wrap {
  position: relative;
}

.banner {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 24rpx 22rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  border-radius: 0 0 16rpx 16rpx;
}

.banner-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.dots {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.3s;
}

.dot.active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

.entry {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.entry-item {
  flex: 1;
  border-radius: 20rpx;
  padding: 44rpx 30rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.entry-item:first-child {
  background: linear-gradient(135deg, #409eff, #2b6cb0);
}

.entry-item:last-child {
  background: linear-gradient(135deg, #36cfc9, #13a8a8);
}

.entry-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.entry-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
}

.entry-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.section {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.notice-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.notice-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ecf5ff;
  border-radius: 14rpx;
  font-size: 32rpx;
}

.notice-body {
  flex: 1;
  min-width: 0;
}

.notice-title {
  display: block;
  font-weight: 600;
}

.notice-content {
  display: block;
  color: #999;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.empty {
  color: #ccc;
  text-align: center;
  padding: 20rpx 0;
}
