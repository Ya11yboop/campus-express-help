<view class="container">
  <view class="top-header">
    <view class="top-left">
      <text class="top-title">校园快递</text>
      <text class="top-slogan">便捷 · 高效 · 安全</text>
    </view>
    <view class="top-bell" bindtap="goNotification">
      <text class="bell-icon">🔔</text>
      <view wx:if="{{unreadCount > 0}}" class="bell-dot">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    </view>
  </view>

  <view class="banner-wrap">
    <swiper
      class="banner"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="3000"
      duration="500"
      current="{{currentIndex}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="bannerId">
        <view class="banner-slide">
          <image src="{{item.image}}" mode="aspectFill" class="banner-img" />
          <view class="banner-overlay">
            <text class="banner-title">{{item.title}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="dots">
      <view
        class="dot {{currentIndex === index ? 'active' : ''}}"
        wx:for="{{banners}}"
        wx:key="bannerId"
        data-index="{{index}}"
        bindtap="onDotTap"
      ></view>
    </view>
  </view>

  <view class="entry">
    <view class="entry-item" bindtap="goCreate" data-type="1">
      <text class="entry-icon">🛵</text>
      <text class="entry-title">帮取快递</text>
      <text class="entry-desc">代取驿站包裹</text>
    </view>
    <view class="entry-item" bindtap="goCreate" data-type="2">
      <text class="entry-icon">📮</text>
      <text class="entry-title">帮寄快递</text>
      <text class="entry-desc">上门取件代寄</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">公告</text>
    <view class="notice-item" wx:for="{{notices}}" wx:key="noticeId">
      <view class="notice-icon">📢</view>
      <view class="notice-body">
        <text class="notice-title">{{item.title}}</text>
        <text class="notice-content">{{item.content}}</text>
      </view>
    </view>
    <view wx:if="{{notices.length === 0}}" class="empty">暂无公告</view>
  </view>
</view>
