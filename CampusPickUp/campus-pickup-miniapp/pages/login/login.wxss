.page {
  min-height: 100vh;
  background: #f0f4f8;
}

/* 顶部品牌区（蓝色渐变） */
.hero {
  position: relative;
  height: 400rpx;
  background: linear-gradient(160deg, #409eff 0%, #2b6cb0 100%);
  border-radius: 0 0 60rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.deco-1 {
  width: 280rpx;
  height: 280rpx;
  top: -90rpx;
  right: -70rpx;
}

.deco-2 {
  width: 220rpx;
  height: 220rpx;
  bottom: -70rpx;
  left: -60rpx;
}

.brand-icon {
  font-size: 88rpx;
  margin-bottom: 16rpx;
}

.brand-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

/* 登录卡片 */
.login-card {
  margin: -80rpx 30rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.card-sub {
  margin-top: 8rpx;
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #a0a6ad;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.input-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
}

.ph {
  color: #c0c6cf;
}

.login-btn {
  margin-top: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #409eff, #2b6cb0);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(64, 158, 255, 0.3);
}

.login-btn::after {
  border: none;
}

.hover {
  opacity: 0.85;
  transform: translateY(1rpx);
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 32rpx;
}

.line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  padding: 0 24rpx;
  color: #b0b7c3;
  font-size: 24rpx;
}

.wechat-btn {
  height: 92rpx;
  line-height: 92rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
}

.wechat-btn::after {
  border: none;
}
