.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-top: 40rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tag {
  background: #ecf5ff;
  color: #409eff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.status {
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: #ecf5ff;
  color: #409eff;
  font-weight: 600;
  font-size: 26rpx;
}

.info {
  display: block;
  color: #666;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.actions {
  margin-top: 30rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.panel {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 60rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  z-index: 101;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 28rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.star {
  font-size: 60rpx;
  color: #e0e4ea;
  transition: color 0.2s;
}

.star.active {
  color: #f7ba2a;
}

.type-seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f5f7fa;
  color: #666;
  font-size: 28rpx;
}

.seg-item.active {
  background: #409eff;
  color: #fff;
  font-weight: 600;
}

.panel-textarea {
  width: 100%;
  height: 180rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.panel-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.panel-btns button {
  flex: 1;
  margin: 0;
}
