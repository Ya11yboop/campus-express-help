.container {
  padding: 30rpx;
}

/* 顶部用户卡片 */
.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #409eff, #2b6cb0);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(64, 158, 255, 0.25);
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.deco1 {
  width: 220rpx;
  height: 220rpx;
  top: -70rpx;
  right: -50rpx;
}

.deco2 {
  width: 150rpx;
  height: 150rpx;
  bottom: -50rpx;
  left: 150rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 52rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-empty {
  background: rgba(255, 255, 255, 0.15);
}

.profile-main {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.name {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
}

.role {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.school-chip {
  align-self: flex-start;
  margin-top: 12rpx;
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
}

.credit-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
}

.credit-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.credit-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

/* 功能菜单 */
.menu-card {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  color: #333;
  font-size: 30rpx;
}

.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
}

.menu-badge {
  margin-left: auto;
  margin-right: 12rpx;
  background: #f56c6c;
  color: #fff;
  font-size: 22rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 信息明细卡片 */
.info-card {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #999;
  font-size: 28rpx;
}

.info-value {
  color: #333;
  font-size: 28rpx;
  max-width: 420rpx;
  text-align: right;
}

.credit {
  color: #f56c6c;
  font-weight: bold;
}

/* 按钮 */
.logout-btn,
.login-btn {
  margin-top: 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}
